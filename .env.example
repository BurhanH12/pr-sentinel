# ──────────────────────────────────────────────────────────────────────────────
# Cursor PR Review Agent — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Cursor SDK ────────────────────────────────────────────────────────────────
# API key from cursor.com/dashboard → Settings → API
# Used by @cursor/sdk to run the review agent (local runtime, against a temp
# checkout of the PR). Same key works for personal and team accounts.
CURSOR_API_KEY=

# ── GitHub authentication ─────────────────────────────────────────────────────
# Fine-grained Personal Access Token (recommended) or classic PAT.
# Create at: https://github.com/settings/personal-access-tokens/new
#
# REQUIRED FINE-GRAINED PERMISSIONS (Repository access):
#   ┌───────────────────────────────────────────────────────────────────────┐
#   │ Repository permissions                                                │
#   ├───────────────────────────────────────────────────────────────────────┤
#   │ • Contents         → Read-only      (clone the PR head SHA)           │
#   │ • Metadata         → Read-only      (always required by GitHub)       │
#   │ • Pull requests    → Read and write (post review + inline comments)   │
#   │ • Issues           → Read and write (PR top-level comments use the    │
#   │                                       issues API)                     │
#   │ • Commit statuses  → Read and write (creates the "Cursor PR Review"   │
#   │                                       status shown in the merge bar)  │
#   │                                                                       │
#   │ NOTE: The GitHub Checks API (check runs) requires GitHub App auth     │
#   │ and rejects PATs. We use commit statuses instead — same merge-gate    │
#   │ behaviour, works with any PAT that has the above permissions.         │
#   └───────────────────────────────────────────────────────────────────────┘
#
# REPOSITORY ACCESS:
#   Grant access to every repository whose PRs you want this agent to review.
#   The agent reviews any PR delivered to the webhook for which the PAT has
#   the above permissions; repos the PAT cannot see will simply 404.
#
# CLASSIC PAT EQUIVALENT (if you must use a classic token):
#   • repo  (full control of private repositories)
#   That single scope covers contents + pull requests + issues + statuses.
#   Fine-grained is preferred — narrower blast radius. This app does not use
#   the Checks API even though the classic repo scope would allow it.
#
# NOTE: PR top-level summary comments will be authored by the GitHub account
# that owns this PAT. For team usage, create a dedicated bot account and use
# its PAT here.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Webhook secret — set when you create the GitHub webhook on each repo
# (Settings → Webhooks → Add webhook → Secret). Must match what GitHub sends.
GITHUB_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Directory where the orchestrator clones PR head SHAs for review.
# Each PR review gets its own subdirectory; cleaned up automatically.
CLONE_BASE_DIR=.tmp-clones

# Comma-separated list of branches whose PRs should trigger a review.
# Example: "dev" or "dev,staging,main"
TARGET_BRANCHES=dev

# ── Central config repo (optional) ────────────────────────────────────────────
# If set, the agent fetches per-repo config overrides from:
#   {CONFIG_REPO_OWNER}/{CONFIG_REPO_NAME}/repos/{owner}/{repo}.json
# at ref CONFIG_REPO_REF. The same PAT above must have read access.
CONFIG_REPO_OWNER=
CONFIG_REPO_NAME=
CONFIG_REPO_REF=main

# ── Cursor model ──────────────────────────────────────────────────────────────
# Default is composer-2.5. See https://cursor.com/docs/sdk/typescript for IDs.
CURSOR_MODEL=composer-2.5
# Thinking budget: "low" | "high" (only honored for composer-* models)
CURSOR_THINKING=high

# ── Logging ───────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Review queue ──────────────────────────────────────────────────────────────
# MAX_CONCURRENT_REVIEWS — total parallel review agent runs across all repos.
#   Conservative default of 2 to stay within Cursor API and GitHub rate limits.
#   Increase cautiously; each run clones a repo, calls the Cursor SDK, and
#   makes several GitHub API requests.
MAX_CONCURRENT_REVIEWS=2

# MAX_ACTIVE_PER_REPO — max simultaneous reviews for a single repository.
#   Default 1 means reviews for the same repo are serialized; other repos
#   get their fair share of worker slots via round-robin dispatch.
MAX_ACTIVE_PER_REPO=1

# MAX_QUEUED_REVIEWS — hard cap on total jobs waiting across all repo lanes.
#   When full, new incoming jobs are rejected with an "error" commit status
#   rather than silently dropped. Increase if you have many active repos.
MAX_QUEUED_REVIEWS=200

# ── Repo mirror cache ─────────────────────────────────────────────────────────
# REPO_MIRROR_CACHE_DIR — directory for bare git mirrors kept between reviews.
#   Mirrors reduce repeated GitHub clone time to just fetching new objects.
#   Separate from CLONE_BASE_DIR (ephemeral checkouts) — mirrors persist.
REPO_MIRROR_CACHE_DIR=.repo-mirrors

# REPO_MIRROR_TTL_MS — mirrors not accessed within this window are evicted at
#   startup. Default: 86400000 (24 hours). Set to 0 to disable eviction.
REPO_MIRROR_TTL_MS=86400000

# ── Cursor agent retries ──────────────────────────────────────────────────────
# Retries for retryable CursorAgentError only (startup failures).
CURSOR_AGENT_MAX_RETRIES=1
CURSOR_AGENT_RETRY_BASE_MS=1000

# ── Queue backend ─────────────────────────────────────────────────────────────
# memory — single process (default). redis — durable queue + separate worker.
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379
WORKER_ID=worker-1
REVIEW_JOB_LEASE_MS=3600000
REVIEW_WORKER_POLL_MS=1000

# ── Post-merge learning (optional) ────────────────────────────────────────────
REVIEW_LEARNING_ENABLED=false
REVIEW_LEARNING_PATH=.review-learning/events.jsonl
